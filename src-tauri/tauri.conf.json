{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PPT Agent",
  "version": "0.1.0",
  "identifier": "com.pptagent.app",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "PPT Agent",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 640,
        "decorations": true,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; connect-src 'self' https: http://localhost:1420; img-src 'self' data: https:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDM0RkUyREEwOTg5ODlCRTMKUldUam01aVlvQzMrTkczNmJMSDBLQ1FMZHByMmlVS3F6VXRneTB0RkFVbWkyRlBBbFlCb1R2bHoK",
      "endpoints": [
        "https://github.com/logic-cn/ppt-agent/releases/latest/download/latest.json"
      ]
    }
  }
}
